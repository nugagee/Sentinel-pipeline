{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSentinelBuckets",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::sentinel-landing-olajide",
        "arn:aws:s3:::sentinel-processed-olajide"
      ]
    },
    {
      "Sid": "ReadWriteSentinelObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::sentinel-landing-olajide/*",
        "arn:aws:s3:::sentinel-processed-olajide/*"
      ]
    }
  ]
}
