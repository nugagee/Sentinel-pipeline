{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeReadObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::sentinel-processed-olajide/*"
    },
    {
      "Sid": "SnowflakeListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::sentinel-processed-olajide",
      "Condition": { "StringLike": { "s3:prefix": ["*"] } }
    }
  ]
}
